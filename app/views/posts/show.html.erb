<div>
  <h1 class="font-bold text-4xl">Posts#show</h1>
  <p>Find me in app/views/posts/show.html.erb</p>
  <p><strong>Title:</strong> <%= @post.title %></p>
  <p><strong>Body:</strong> <%= @post.body %></p> 
  <div class="mt-4">
    <%= link_to "Back to Posts", posts_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to "Edit Post", edit_post_path(@post), class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
</div>

